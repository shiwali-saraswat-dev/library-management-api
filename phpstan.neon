includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6

    paths:
        - app
        - bootstrap/app.php
        - routes

    # Raise one level at a time (6 -> 7 -> 8) as the baseline shrinks.
    # Level 6 is where missing return types and iterable value types start being reported.

    # Trust only native types, so defensive instanceof checks aren't flagged as "always true".
    treatPhpDocTypesAsCertain: false
